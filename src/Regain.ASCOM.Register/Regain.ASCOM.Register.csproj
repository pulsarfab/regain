<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Regain.ASCOM/Regain.ASCOM.csproj" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../Regain.FocusCube.ASCOM/Regain.FocusCube.ASCOM.csproj" ReferenceOutputAssembly="false" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../Regain.Ofp2.ASCOM/Regain.Ofp2.ASCOM.csproj" ReferenceOutputAssembly="false" /></ItemGroup>
  <Target Name="CopyFocusCubeServer" AfterTargets="Build">
    <ItemGroup><FocusCubeFiles Include="../Regain.FocusCube.ASCOM/bin/$(Configuration)/net48/Regain.FocusCube.ASCOM.exe*" /></ItemGroup>
    <Copy SourceFiles="@(FocusCubeFiles)" DestinationFolder="$(OutDir)" />
  </Target>
  <Target Name="CopyOfp2Server" AfterTargets="Build">
    <ItemGroup><Ofp2Files Include="../Regain.Ofp2.ASCOM/bin/$(Configuration)/net48/Regain.Ofp2.ASCOM.exe*" /></ItemGroup>
    <Copy SourceFiles="@(Ofp2Files)" DestinationFolder="$(OutDir)" />
  </Target>
  <ItemGroup><ProjectReference Include="../Regain.Eta.ASCOM/Regain.Eta.ASCOM.csproj" ReferenceOutputAssembly="false" /></ItemGroup>
  <Target Name="CopyEtaServer" AfterTargets="Build">
    <ItemGroup><EtaFiles Include="../Regain.Eta.ASCOM/bin/$(Configuration)/net48/Regain.Eta.ASCOM.exe*" /></ItemGroup>
    <Copy SourceFiles="@(EtaFiles)" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
