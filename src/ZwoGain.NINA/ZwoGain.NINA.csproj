<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <Version>0.1.0.0</Version>
    <AssemblyTitle>ZwoGain</AssemblyTitle>
    <Title>ZwoGain</Title>
    <Authors>Yann Ramin</Authors>
    <Company>Yann Ramin</Company>
    <Description>Process-isolated ZWO cameras with automatic capture recovery</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ZwoGain.NINA.Tests" />
    <ProjectReference Include="../ZwoGain.Core/ZwoGain.Core.csproj" />
    <PackageReference Include="NINA.Plugin" Version="3.2.0.9001" PrivateAssets="all" />
  </ItemGroup>
</Project>
