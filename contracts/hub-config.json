        "type": "string",
        "x-regain": {
          "apply": "reconnect"
        }
      },
      "schemaVersion": {
        "const": 1,
        "description": "Persisted configuration format; unsupported versions require explicit migration.",
        "format": "uint32",
        "minimum": 0,
        "readOnly": true,
        "title": "Schema Version",
        "type": "integer",
        "x-regain": {
          "apply": "reconnect"
        }
      },
      "sources": {
        "description": "Sources shared by virtual devices. Configure each physical/remote source once.",
        "items": {
          "$ref": "#/$defs/SourceConfig"
        },
        "maxItems": 256,
        "title": "Sources",
        "type": "array",
        "x-regain": {
          "apply": "reconnect"
        }
      }
    },
    "required": [
      "schemaVersion",
      "revision",
      "instanceId",
      "sources",
      "outputs"
    ],
    "title": "HubConfig",
    "type": "object"
  },
  "schemaVersion": 1,
  "validation": "The hub validates relationships, identities, capabilities and revisions before applying. Schema validation alone does not authorize an update."
}
