    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "identities": {
        "$ref": "#/$defs/IdentityLedger",
        "default": {
          "channels": {},
          "outputs": {},
          "sources": {}
        },
        "description": "Owned by the store. Retired IDs remain reserved after deletion/restart.",
        "readOnly": true,
        "title": "Identities",
        "x-regain": {
          "hidden": true
        }
      },
      "instanceId": {
        "description": "Stable hub instance identity; never copied from another installation.",
        "format": "uuid",
        "readOnly": true,
        "title": "Instance Id",
        "type": "string",
        "x-regain": {
          "apply": "reconnect"
        }
      },
      "outputs": {
        "description": "Virtual devices published through NINA, Alpaca, or native ASCOM.",
