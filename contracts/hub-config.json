                  },
                  "dewpoint": {
                    "$ref": "#/$defs/Measurement",
                    "title": "Dewpoint",
                    "x-regain": {
                      "apply": "reconnect"
                    }
                  },
                  "humidity": {
                    "$ref": "#/$defs/Measurement",
                    "title": "Humidity",
                    "x-regain": {
                      "apply": "reconnect"
                    }
                  },
                  "pressure": {
                    "$ref": "#/$defs/Measurement",
                    "title": "Pressure",
                    "x-regain": {
                      "apply": "reconnect"
                    }
                  },
                  "rainrate": {
                    "$ref": "#/$defs/Measurement",
                    "title": "Rainrate",
                    "x-regain": {
                      "apply": "reconnect"
                    }
                  },
                  "skybrightness": {
                    "$ref": "#/$defs/Measurement",
                    "title": "Skybrightness",
                    "x-regain": {
                      "apply": "reconnect"
                    }
                  },
                  "skyquality": {
                    "$ref": "#/$defs/Measurement",
                    "title": "Skyquality",
                    "x-regain": {
                      "apply": "reconnect"
                    }
                  },
                  "skytemperature": {
                    "$ref": "#/$defs/Measurement",
                    "title": "Skytemperature",
                    "x-regain": {
                      "apply": "reconnect"
                    }
                  },
                  "starfwhm": {
                    "$ref": "#/$defs/Measurement",
                    "title": "Starfwhm",
                    "x-regain": {
                      "apply": "reconnect"
                    }
                  },
                  "temperature": {
                    "$ref": "#/$defs/Measurement",
                    "title": "Temperature",
                    "x-regain": {
                      "apply": "reconnect"
                    }
                  },
                  "winddirection": {
                    "$ref": "#/$defs/Measurement",
                    "title": "Winddirection",
                    "x-regain": {
